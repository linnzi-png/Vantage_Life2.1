{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/get-iphone", "destination": "https://testflight.apple.com/join/sAsefB12", "permanent": false },
    { "source": "/get-android", "destination": "https://expo.dev/artifacts/eas/SC0XZyQ-7Qc55DqeeU5K6CNYbObyNIzchcB4QnRSdO4.apk", "permanent": false }
