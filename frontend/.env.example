# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored; never commit real credentials.

# Railway backend URL — get this from your Railway project dashboard
EXPO_PUBLIC_BACKEND_URL=https://vantagelife21-production.up.railway.app

# Direct Google sign-in (from Google Cloud Console → Credentials). When the
# web client ID is set, the Google button uses the direct flow; unset, it
# falls back to the legacy Emergent portal.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
