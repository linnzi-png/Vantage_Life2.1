# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored; never commit real credentials.

# Railway backend URL — get this from your Railway project dashboard
EXPO_PUBLIC_BACKEND_URL=https://vantagelife21-production.up.railway.app

# Google sign-in via Auth0 (Auth0 dashboard → Applications). Same tenant
# domain for both platforms; separate client IDs per Auth0 application.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_WEB_CLIENT_ID=
EXPO_PUBLIC_AUTH0_IOS_CLIENT_ID=
