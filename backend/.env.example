MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net
DB_NAME=vantagelife
PORT=8000
# Direct Google sign-in: comma-separated OAuth client IDs accepted as ID-token
# audience (iOS client + web client, from Google Cloud Console). Unset =
# /api/auth/google returns 503 and the Emergent flow keeps handling Google.
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com
