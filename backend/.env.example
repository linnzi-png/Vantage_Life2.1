MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net
DB_NAME=vantagelife
PORT=8000
# Google sign-in via Auth0 (Auth0 dashboard → Applications). AUTH0_DOMAIN is
# the tenant domain (no https://, no trailing slash). AUTH0_CLIENT_IDS is a
# comma-separated list of application client IDs accepted as ID-token
# audience (iOS client + web client). Unset = /api/auth/auth0 returns 503.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
