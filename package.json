{
  "name": "vantage-life-2-1",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uvicorn server:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run web",
    "install:all": "pip install -r backend/requirements.txt && yarn --cwd frontend install",
    "build": "cd frontend && npx expo export --platform web",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "test": "python -m pytest backend/tests -v",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
